# Optional: override local storage; defaults to ~/.clax.
CLAX_HOME=
# Show the window immediately (normally it starts hidden in the tray).
CLAX_SHOW=1
# Optional: use your own OpenRouter inference key, or configure it in Settings.
OPENROUTER_API_KEY=
# Configure API keys in Settings -> Providers. Keys use Electron safeStorage.
# Keys are never loaded from this example file.
